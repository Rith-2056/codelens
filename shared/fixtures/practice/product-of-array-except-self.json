{"program":"class Solution:\n    def productExceptSelf(self, nums: List[int]) -> List[int]:\n        n = len(nums)\n        answer = [1] * n\n        for i in range(1, n):\n            answer[i] = answer[i - 1] * nums[i - 1]\n        suffix = 1\n        for i in range(n - 1, -1, -1):\n            answer[i] *= suffix\n            suffix *= nums[i]\n        return answer\n\n# CodeLens runs your solution on this input:\nnums = [2, 3, 4, 5]\nresult = Solution().productExceptSelf(nums)\nprint(result)\n","trace":{"status":"ok","truncated":false,"codeHash":"39f1daf6166710e5caf2121c2ccb50779143ab04ed294de7688288988f3f372a","steps":[{"index":0,"line":1,"event":"call","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":1,"line":1,"event":"line","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":2,"line":1,"event":"call","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":3,"line":1,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":4,"line":2,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":2,"locals":{}}]},{"index":5,"line":2,"event":"return","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{"productExceptSelf"