{"program":"class Solution:\n    def dailyTemperatures(self, temperatures: List[int]) -> List[int]:\n        answer = [0] * len(temperatures)\n        stack = []\n        for i in range(len(temperatures)):\n            while stack and temperatures[i] > temperatures[stack[-1]]:\n                j = stack.pop()\n                answer[j] = i - j\n            stack.append(i)\n        return answer\n\n# CodeLens runs your solution on this input:\ntemperatures = [64, 66, 61, 63, 70, 62]\nresult = Solution().dailyTemperatures(temperatures)\nprint(result)\n","trace":{"status":"ok","truncated":false,"codeHash":"8bd111daca15687d881f96c1f59f4a62ce7f6d77a8b7fe09d841dd1ee8767d89","steps":[{"index":0,"line":1,"event":"call","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":1,"line":1,"event":"line","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":2,"line":1,"event":"call","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":3,"line":1,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":4,"line":2,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":2,"locals":{}}]},{"index":5,"line":2,"event":"return","functionName":"Solution","frameId