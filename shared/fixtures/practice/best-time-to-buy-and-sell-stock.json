{"program":"class Solution:\n    def maxProfit(self, prices: List[int]) -> int:\n        left = 0\n        best = 0\n        for right in range(1, len(prices)):\n            if prices[right] < prices[left]:\n                left = right\n            else:\n                best = max(best, prices[right] - prices[left])\n        return best\n\n# CodeLens runs your solution on this input:\nprices = [8, 2, 6, 1, 5, 9]\nresult = Solution().maxProfit(prices)\nprint(result)\n","trace":{"status":"ok","truncated":false,"codeHash":"dde8ffc57539c6d9dd15c3f9fd53a6e81bf95272d7cf2afcc0bc5926a771d315","steps":[{"index":0,"line":1,"event":"call","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":1,"line":1,"event":"line","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":2,"line":1,"event":"call","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":3,"line":1,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":4,"line":2,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":2,"locals":{}}]},{"index":5,"line":2,"event":"return","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{"maxProfit":{"__type__":"function"}},"stdout":""