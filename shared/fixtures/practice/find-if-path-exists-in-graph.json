{"program":"class Solution:\n    def validPath(self, n: int, edges: List[List[int]], source: int, destination: int) -> bool:\n        graph = {node: [] for node in range(n)}\n        for u, v in edges:\n            graph[u].append(v)\n            graph[v].append(u)\n        visited = {source}\n        queue = deque([source])\n        while queue:\n            node = queue.popleft()\n            if node == destination:\n                return True\n            for nxt in graph[node]:\n                if nxt not in visited:\n                    visited.add(nxt)\n                    queue.append(nxt)\n        return False\n\n# CodeLens runs your solution on this input:\nn = 5\nedges = [[0, 1], [1, 2], [3, 4]]\nsource = 0\ndestination = 2\nresult = Solution().validPath(n, edges, source, destination)\nprint(result)\n","trace":{"status":"ok","truncated":false,"codeHash":"ca1fa81b84a04dc190641235125e234260a8d22806c4958c799214e4d0ed8116","steps":[{"index":0,"line":1,"event":"call","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":1,"line":1,"event":"line","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":2,"line":1,"event":"call","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":3,"line":1,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":4,"line":2,"event":"line","functionName":"Solution","frameId":"Solution-1"