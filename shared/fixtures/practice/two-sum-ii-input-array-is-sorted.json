{"program":"class Solution:\n    def twoSum(self, numbers: List[int], target: int) -> List[int]:\n        left = 0\n        right = len(numbers) - 1\n        while left < right:\n            total = numbers[left] + numbers[right]\n            if total == target:\n                return [left + 1, right + 1]\n            elif total < target:\n                left += 1\n            else:\n                right -= 1\n        return []\n\n# CodeLens runs your solution on this input:\nnumbers = [1, 3, 4, 6, 8, 11]\ntarget = 10\nresult = Solution().twoSum(numbers, target)\nprint(result)\n","trace":{"status":"ok","truncated":false,"codeHash":"846c1030347b92cb107918fa98618888b7861a8aa69e963e9d5048834b427342","steps":[{"index":0,"line":1,"event":"call","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":1,"line":1,"event":"line","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":2,"line":1,"event":"call","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":3,"line":1,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":4,"line":2,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":2,"locals":{}}]},{"index":5,"line":2,"event":"return","