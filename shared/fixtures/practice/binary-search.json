{"program":"class Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        left = 0\n        right = len(nums) - 1\n        while left <= right:\n            mid = (left + right) // 2\n            if nums[mid] == target:\n                return mid\n            elif nums[mid] < target:\n                left = mid + 1\n            else:\n                right = mid - 1\n        return -1\n\n# CodeLens runs your solution on this input:\nnums = [-3, 0, 4, 7, 10, 15]\ntarget = 7\nresult = Solution().search(nums, target)\nprint(result)\n","trace":{"status":"ok","truncated":false,"codeHash":"0a00d929d68905c3c3d8bd96d207703b53d4c25ab0b9f6642808e571cdd78c32","steps":[{"index":0,"line":1,"event":"call","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":1,"line":1,"event":"line","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":2,"line":1,"event":"call","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":3,"line":1,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":4,"line":2,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":2,"locals":{}}]},{"index":5,"line":2,"event":"return","functionName":"Solution","fra