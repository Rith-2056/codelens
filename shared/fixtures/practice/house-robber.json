{"program":"class Solution:\n    def rob(self, nums: List[int]) -> int:\n        dp = [0] * len(nums)\n        dp[0] = nums[0]\n        for i in range(1, len(nums)):\n            take = nums[i] + (dp[i - 2] if i >= 2 else 0)\n            dp[i] = max(dp[i - 1], take)\n        return dp[-1]\n\n# CodeLens runs your solution on this input:\nnums = [2, 9, 4, 3, 7]\nresult = Solution().rob(nums)\nprint(result)\n","trace":{"status":"ok","truncated":false,"codeHash":"2b97fa3f6d5410ac2dd8db09265ed64f848c922931ee3b1f01d4310d3a2a2b35","steps":[{"index":0,"line":1,"event":"call","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":1,"line":1,"event":"line","functionName":"<module>","frameId":"module","depth":0,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}}]},{"index":2,"line":1,"event":"call","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":3,"line":1,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":1,"locals":{}}]},{"index":4,"line":2,"event":"line","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{},"stdout":"","heap":{},"stack":[{"functionName":"<module>","frameId":"module","line":1,"locals":{}},{"functionName":"Solution","frameId":"Solution-1","line":2,"locals":{}}]},{"index":5,"line":2,"event":"return","functionName":"Solution","frameId":"Solution-1","depth":1,"locals":{"rob":{"__type__":"function"}},"stdout":"","returnValue":null,"heap":{},"stack":[{"functionName":"<module>","fra