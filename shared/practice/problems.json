{
  "two-sum": {
    "method": "twoSum",
    "params": ["nums", "target"],
    "compare": "same-items",
    "examples": [
      { "args": [[3, 8, 5, 1], 6], "expected": [2, 3] },
      { "args": [[4, 4], 8], "expected": [0, 1] },
      { "args": [[-2, 7, 11, 5], 9], "expected": [0, 2] }
    ]
  },
  "contains-duplicate": {
    "method": "containsDuplicate",
    "params": ["nums"],
    "compare": "exact",
    "examples": [
      { "args": [[5, 1, 8, 1, 3]], "expected": true },
      { "args": [[2, 9, 4]], "expected": false },
      { "args": [[7]], "expected": false }
    ]
  },
  "two-sum-ii-input-array-is-sorted": {
    "method": "twoSum",
    "params": ["numbers", "target"],
    "compare": "exact",
    "examples": [
      { "args": [[1, 3, 4, 6, 8, 11], 10], "expected": [3, 4] },
      { "args": [[-3, 0, 2, 5], -1], "expected": [1, 3] },
      { "args": [[1, 2], 3], "expected": [1, 2] }
    ]
  },
  "find-if-path-exists-in-graph": {
    "method": "validPath",
    "params": ["n", "edges", "source", "destination"],
    "compare": "exact",
    "examples": [
      { "args": [5, [[0, 1], [1, 2], [3, 4]], 0, 2], "expected": true },
      { "args": [5, [[0, 1], [1, 2], [3, 4]], 0, 4], "expected": false },
      { "args": [1, [], 0, 0], "expected": true }
    ]
  },
  "maximum-depth-of-binary-tree": {
    "method": "maxDepth",
    "params": ["root"],
    "tree_params": ["root"],
    "compare": "exact",
    "examples": [
      { "args": [[1, 2, 3, 4, null, null, 5, null, null, 6]], "expected": 4 },
      { "args": [[7]], "expected": 1 },
      { "args": [[]], "expected": 0 }
    ]
  },
  "climbing-stairs": {
    "method": "climbStairs",
    "params": ["n"],
    "compare": "exact",
    "examples": [
      { "args": [6], "expected": 13 },
      { "args": [1], "expected": 1 },
      { "args": [4], "expected": 5 }
    ]
  }
}
